# ============================================================
# WEB-AI environment variables
# Copy this file to .env (local dev) or set these in the
# Vercel Project Settings → Environment Variables (production).
# NEVER commit a real .env file.
# ============================================================

# --- xKiro (primary AI provider) — REQUIRED for chat to work ---
# https://docs.xkiro.com/
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Only used as a fallback label before the live /v1/models list loads.
XKIRO_DEFAULT_MODEL=mistralai/mistral-small-2603

# --- Web Search plugin (Brave Search API) — optional ---
# https://api.search.brave.com/app/documentation/web-search/get-started
SEARCH_API_KEY=

# --- Weather plugin (OpenWeatherMap) — optional ---
# https://openweathermap.org/current
WEATHER_API_KEY=

# --- YouTube plugin (YouTube Data API v3) — optional ---
# Only needed for *search*. Playback works with no key.
# https://developers.google.com/youtube/v3/docs/search/list
YOUTUBE_API_KEY=

# --- Persistent storage (Upstash Redis REST API) ---
# REQUIRED for: GitHub sessions/approvals and distributed rate limiting.
# https://upstash.com/docs/redis/features/restapi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Session encryption ---
# REQUIRED to store GitHub tokens encrypted at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# --- App ---
NODE_ENV=production
PUBLIC_APP_URL=
